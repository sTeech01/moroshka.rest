# Адрес сайта (для sitemap, OG, ссылок в уведомлениях)
NEXT_PUBLIC_SITE_URL=https://moroshka.rest

# --- CMS Payload (админка /admin) ---
# Длинная случайная строка: openssl rand -hex 32. Без неё прод не запустится
PAYLOAD_SECRET=
# База SQLite. На сервере — постоянный путь вне папки релиза, например file:/var/lib/moroshka/payload.db
DATABASE_URL=file:./data/payload.db

# --- Аналитика ---
# Счётчик Яндекс Метрики, который сейчас стоит на myresto. Сохранить его — значит не потерять историю статистики.
# Подключать вместе с cookie-баннером
NEXT_PUBLIC_YANDEX_METRIKA_ID=67068706

# --- Провайдеры: mock | iiko ---
MENU_PROVIDER=mock
# telegram | iiko
ORDER_PROVIDER=telegram
# mock | yookassa | tbank (реальные — следующий этап)
PAYMENT_PROVIDER=mock
# Показывать ли пункт «Онлайн-оплата» в оформлении заказа
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED=false

# --- iikoCloud (заполняется после получения доступа) ---
IIKO_API_URL=https://api-ru.iiko.services
IIKO_API_LOGIN=
# Скорее всего e10b3abe-7d88-4340-8ae2-70c7560c0c13 — ID из меню myresto. Сверить через /api/1/organizations
IIKO_ORGANIZATION_ID=
IIKO_TERMINAL_GROUP_ID=
IIKO_EXTERNAL_MENU_ID=
IIKO_PRICE_CATEGORY_ID=
# Меню зала (раздел /menu). Пусто — меню из data/iiko-mock/hall-menu.json
IIKO_HALL_MENU_ID=
IIKO_HALL_PRICE_CATEGORY_ID=
IIKO_PAYMENT_TYPE_CASH_ID=
IIKO_PAYMENT_TYPE_CARD_ID=
IIKO_PAYMENT_TYPE_ONLINE_ID=

# Секрет для вебхука сброса кэша меню (/api/revalidate)
REVALIDATE_SECRET=

# --- Уведомления о заказах, бронях и заявках ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- DaData: подсказки адреса ---
DADATA_API_KEY=
